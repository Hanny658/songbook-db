{
  "title": "I Know Who Holds Tomorrow",
  "number": 149,
  "lyrics": [
    {
      "id": "verse1",
      "label": "Verse 1",
      "lines": [
        {
          "chords": "C",
          "lyrics": "I don't know about tomorrow"
        },
        {
          "chords": "C7     F                C",
          "lyrics": "I just live from day to day"
        },
        {
          "chords": "C7      F               C",
          "lyrics": "I don't borrow from its sunshine"
        },
        {
          "chords": "        D7                G",
          "lyrics": "For its skies may turn to grey"
        },
        {
          "chords": "        C",
          "lyrics": "I don't worry over the future"
        },
        {
          "chords": "C7    F               C",
          "lyrics": "For I know what Jesus said;"
        },
        {
          "chords": "C7  F                C",
          "lyrics": "And today, I'll walk beside Him"
        },
        {
          "chords": "       G     G7      C",
          "lyrics": "For He knows what is ahead"
        }
      ]
    },
    {
      "id": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "chords": "C7   F            C",
          "lyrics": "Many things about tomorrow"
        },
        {
          "chords": "        D7           G",
          "lyrics": "I don't seem to understand"
        },
        {
          "chords": "      C    C7        F",
          "lyrics": "But I know who holds tomorrow"
        },
        {
          "chords": "      C/G      G7       C",
          "lyrics": "And I know who holds my hand"
        }
      ]
    },
    {
      "id": "verse2",
      "label": "Verse 2",
      "lines": [
        {
          "chords": "C",
          "lyrics": "Every step is getting brighter"
        },
        {
          "chords": "C7     F               C",
          "lyrics": "As the golden stairs I climb"
        },
        {
          "chords": "C7    F                C",
          "lyrics": "Every burden's getting lighter"
        },
        {
          "chords": "      D7             G",
          "lyrics": "Every cloud is silverlined"
        },
        {
          "chords": "          C",
          "lyrics": "There the sun is always shining"
        },
        {
          "chords": "C7       F             C",
          "lyrics": "There no tear will dim the eye"
        },
        {
          "chords": "C7     F             C",
          "lyrics": "At the ending of the rainbow"
        },
        {
          "chords": "          G         G7        C",
          "lyrics": "Where the mountains touch the sky"
        }
      ]
    },
    {
      "id": "verse3",
      "label": "Verse 3",
      "lines": [
        {
          "chords": "C",
          "lyrics": "I don't know about tomorrow"
        },
        {
          "chords": "C7     F             C",
          "lyrics": "It may bring me poverty"
        },
        {
          "chords": "C7      F                 C",
          "lyrics": "But the One who feeds the sparrow"
        },
        {
          "chords": "       D7                G",
          "lyrics": "Is the One who stands by me"
        },
        {
          "chords": "        C",
          "lyrics": "And the path that be my portion"
        },
        {
          "chords": "C7     F                 C",
          "lyrics": "May be thru the flame or flood"
        },
        {
          "chords": "C7       F              C",
          "lyrics": "But His presence goes before me"
        },
        {
          "chords": "        G       G7       C",
          "lyrics": "And I'm covered with His blood"
        }
      ]
    }

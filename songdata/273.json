      "lines": [
        {
          "chords": "Em",
          "lyrics": "From the highest of heights"
        },
        {
          "chords": "       Dsus/F#   G   G2",
          "lyrics": "To the depths of the sea"
        },
        {
          "chords": "Am              Am7/G           F",
          "lyrics": "Creation's revealing Your majesty"
        },
        {
          "chords": "Em",
          "lyrics": "From the colours of fall"
        },
        {
          "chords": "       Dsus/F#      G   G2",
          "lyrics": "To the fragrance of spring"
        },
        {
          "chords": "Am                          Am7/G",
          "lyrics": "Every creature unique in the song"
        },
        {
          "chords": "        F",
          "lyrics": "That it sings"
        },
        {
          "chords": "C     D",
          "lyrics": "All exclaiming"
        }
      ]
    },
    {
      "id": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "chords": "G                   Dsus",
          "lyrics": "Indescribable, Uncontainable,"
        },
        {
          "chords": "C2",
          "lyrics": "You placed the stars in the sky"
        },
        {
          "chords": "             Em",
          "lyrics": "And You know them by name"
        },
        {
          "chords": "                   C2",
          "lyrics": "You are amazing God"
        },
        {
          "chords": "G  G2           Dsus",
          "lyrics": "All powerful, Untameable,"
        },
        {
          "chords": "C2",
          "lyrics": "Awestruck we fall to our knees"
        },
        {
          "chords": "             Em",
          "lyrics": "As we humbly proclaim"
        },
        {
          "chords": "G/B             C2",
          "lyrics": "You are amazing God"
        }
      ]
    },
    {
      "id": "verse2",
      "label": "Verse 2",
      "lines": [
        {
          "chords": "Em",
          "lyrics": "Who has told every lightning bolt"
        },
        {
          "chords": "Dsus/F#         G  G2",
          "lyrics": "Where it should go"
        },
        {
          "chords": "Am                    Am7/G",
          "lyrics": "Or seen heavenly storehouses"
        },
        {
          "chords": "           F",
          "lyrics": "Laden with snow"
        },
        {
          "chords": "Em",
          "lyrics": "Who imagined the sun"
        },
        {
          "chords": "          Dsus/F#         G  G2",
          "lyrics": "And gives source to its light"
        },
        {
          "chords": "Am",
          "lyrics": "Yet conceals it to bring us"
        },
        {
          "chords": "Am7/G           F",
          "lyrics": "the coolness of night"
        },
        {
          "chords": "C        D",
          "lyrics": "None can fathom"
        }
      ]
    },
